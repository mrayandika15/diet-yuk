{
  "name": "diet-yuk",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo-google-fonts/nunito": "^0.4.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.117.2",
    "expo": "~57.0.27",
    "expo-constants": "~57.0.21",
    "expo-dev-client": "~57.0.19",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image-manipulator": "~57.0.21",
    "expo-image-picker": "~57.0.20",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.12",
    "expo-notifications": "~57.0.22",
    "expo-router": "~57.0.25",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.10.1",
    "recharts": "^3.10.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/react": "~19.2.2",
    "prettier": "^3.9.9",
    "serve": "^14.2.6",
    "supabase": "^2.119.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "workbox-cli": "^7.4.1"
  },
  "scripts": {
    "start": "expo start --web",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "export:web": "expo export --platform web",
    "build:pwa": "expo export --platform web --clear && workbox generateSW workbox-config.js",
    "preview:pwa": "serve dist --single",
    "db:push": "supabase db push",
    "test:gateway": "python3 -m unittest discover -s tests -p '*_test.py'",
    "test:db": "bash scripts/test-db.sh",
    "test:supabase": "node --env-file=.env scripts/test-supabase-live.mjs",
    "format": "prettier --write app src tests package.json app.json tsconfig.json",
    "import:tkpi": "tsx scripts/import-tkpi.ts"
  },
  "private": true
}
