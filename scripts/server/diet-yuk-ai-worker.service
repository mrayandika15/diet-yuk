[Unit]
Description=Diet Yuk managed photo analysis worker
After=network-online.target hermes-gateway-diet-yuk.service
[Service]
ExecStart=/usr/bin/python3 %h/.local/share/diet-yuk/ai-worker.py
EnvironmentFile=%h/.hermes/profiles/diet-yuk/.env
EnvironmentFile=%h/.config/diet-yuk/ai-worker.env
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
UMask=0077
[Install]
WantedBy=default.target
